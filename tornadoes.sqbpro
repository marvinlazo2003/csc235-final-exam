    tornado_name, category, wind_speed, date_occurred, state_id, description
)
VALUES (
    '2011 Joplin Tornado',
    'EF5',
    200,
    '2011-05-22',
    1,
    'One of the deadliest EF5 tornadoes in U.S. history, devastating Joplin, Missouri.'
);</sql><sql name="SQL 2*">INSERT INTO tornadoes (
    tornado_name, category, wind_speed, date_occurred, state_id, description
)
VALUES (
    '1925 Tri-State Tornado',
    'F5',
    207,
    '1925-03-18',
    3,
    'Longest tracked tornado in U.S. history, crossing Missouri, Illinois, and Indiana.'
);</sql><sql name="SQL 3*">INSERT INTO tornadoes (
    tornado_name, category, wind_speed, date_occurred, state_id, description
)
